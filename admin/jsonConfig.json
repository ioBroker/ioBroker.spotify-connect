{
  "type": "tabs",
  "i18n": true,
  "items": {
    "_spotify": {
      "type": "panel",
      "label": "Spotify",
      "items": {
        "_howtoHeader": {
          "type": "header",
          "size": 4,
          "text": "How to get the Soloist API key",
          "sm": 12
        },
        "_howto": {
          "type": "staticText",
          "sm": 12,
          "text": "This adapter uses Spotify Soloist, the official Spotify Connect receiver from Spotify. Soloist needs a personal API key.<br><br><b>1.</b> You need a Spotify <b>Premium</b> account to create the key. Later, Free accounts can also play on the device.<br><b>2.</b> Open the Spotify for Developers dashboard (first button below) and log in with your normal Spotify account. On the first visit accept the developer terms.<br><b>3.</b> Open the page <b>Spotify Soloist API Key</b> (second button below).<br><b>4.</b> Accept the Spotify terms if asked and generate the key.<br><b>5.</b> Copy the key. It starts with <code>spak_</code>. Paste it into the field below. Do not share it: every user needs an own key.<br><b>6.</b> Save. The adapter downloads Soloist and all required system packages by itself and keeps Soloist up to date (Spotify builds expire after 90 days).<br><b>7.</b> Open the Spotify app on your phone or PC in the same network, tap the device icon and select the device name entered below. The first time, this logs Soloist into your account."
        },
        "_linkDashboard": {
          "type": "staticLink",
          "button": true,
          "variant": "outlined",
          "href": "https://developer.spotify.com/dashboard",
          "label": "1. Open Spotify for Developers",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "newLine": true
        },
        "_linkSoloist": {
          "type": "staticLink",
          "button": true,
          "variant": "contained",
          "href": "https://developer.spotify.com/dashboard/soloist",
          "label": "2. Create Soloist API key",
          "sm": 12,
          "md": 6,
          "lg": 4
        },
        "apiKey": {
          "type": "password",
          "repeat": false,
          "visible": true,
          "label": "Soloist API key",
          "help": "Starts with spak_",
          "validator": "!data.apiKey || data.apiKey.startsWith('spak_')",
          "validatorErrorText": "Key must start with spak_",
          "validatorNoSaveOnError": true,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "newLine": true
        },
        "deviceName": {
          "type": "text",
          "label": "Device name in the Spotify app",
          "help": "e.g. Living room",
          "sm": 12,
          "md": 6,
          "lg": 4
        },
        "_linkDocs": {
          "type": "staticLink",
          "href": "https://developer.spotify.com/documentation/soloist",
          "label": "Spotify Soloist documentation",
          "sm": 12,
          "newLine": true
        }
      }
    },
    "_players": {
      "type": "panel",
      "label": "Players",
      "items": {
        "_playersInfo": {
          "type": "staticText",
          "sm": 12,
          "text": "When you play on this device in the Spotify app, the adapter writes the stream URL into these states. Any state with role <code>media.url</code> works, e.g. for a ThirdReality speaker in ioBroker.assistant: <code>assistant.0.satellites.&lt;Name&gt;.controls.linux_voice_assistant_media_player.url</code>. After a pause the players are stopped again."
        },
        "targets": {
          "type": "table",
          "sm": 12,
          "noDelete": false,
          "items": [
            {
              "type": "checkbox",
              "attr": "enabled",
              "title": "Active",
              "width": 80,
              "default": true
            },
            {
              "type": "objectId",
              "attr": "id",
              "title": "media.url state",
              "types": "state",
              "customFilter": {
                "common": {
                  "role": ["media.url"]
                }
              }
            }
          ]
        },
        "stopAfterSec": {
          "type": "number",
          "min": 0,
          "label": "Stop players after pause (seconds)",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "newLine": true
        }
      }
    },
    "_advanced": {
      "type": "panel",
      "label": "Advanced",
      "items": {
        "streamHost": {
          "type": "ip",
          "listenOnAllPorts": false,
          "onlyIp4": true,
          "label": "Address the players use to reach ioBroker",
          "help": "Empty = detect automatically",
          "sm": 12,
          "md": 6,
          "lg": 4
        },
        "streamPort": {
          "type": "port",
          "label": "Stream port",
          "sm": 12,
          "md": 3,
          "lg": 2
        },
        "format": {
          "type": "select",
          "label": "Stream format",
          "options": [
            {
              "label": "MP3 256 kbit/s",
              "value": "mp3"
            },
            {
              "label": "FLAC (lossless)",
              "value": "flac"
            }
          ],
          "sm": 12,
          "md": 3,
          "lg": 2
        },
        "apiPort": {
          "type": "port",
          "label": "Local Soloist API port",
          "help": "Only on 127.0.0.1. Must differ per instance",
          "sm": 12,
          "md": 3,
          "lg": 2,
          "newLine": true
        }
      }
    }
  }
}
