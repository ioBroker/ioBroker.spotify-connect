{
  "common": {
    "name": "spotify-connect",
    "version": "0.1.0",
    "news": {
      "0.1.0": {
        "en": "initial release",
        "de": "Erstveröffentlichung",
        "ru": "первый выпуск"
      }
    },
    "title": "Spotify Connect",
    "titleLang": {
      "en": "Spotify Connect",
      "de": "Spotify Connect",
      "ru": "Spotify Connect"
    },
    "desc": {
      "en": "Spotify Connect receiver based on Spotify Soloist. Streams to any player with a media.url state (e.g. ioBroker.assistant satellites)",
      "de": "Spotify-Connect-Empfänger auf Basis von Spotify Soloist. Streamt an jeden Player mit media.url-State (z. B. Satelliten von ioBroker.assistant)",
      "ru": "Приёмник Spotify Connect на базе Spotify Soloist. Передаёт звук на любой плеер с состоянием media.url"
    },
    "authors": [
      "ioBroker GmbH <Iobroker.gmbh@gmail.com>"
    ],
    "keywords": [
      "spotify",
      "spotify connect",
      "soloist",
      "audio",
      "speaker"
    ],
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "type": "multimedia",
    "compact": true,
    "connectionType": "local",
    "dataSource": "push",
    "adminUI": {
      "config": "json"
    },
    "tier": 3,
    "materialize": false,
    "supportedMessages": {},
    "dependencies": [
      {
        "js-controller": ">=5.0.19"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=6.17.14"
      }
    ],
    "osDependencies": {
      "linux": [
        "pipewire",
        "pipewire-pulse",
        "wireplumber",
        "pulseaudio-utils",
        "ffmpeg"
      ]
    },
    "os": [
      "linux"
    ],
    "icon": "spotify-connect.png",
    "extIcon": "https://raw.githubusercontent.com/ioBroker/ioBroker.spotify-connect/main/admin/spotify-connect.png",
    "readme": "https://github.com/ioBroker/ioBroker.spotify-connect/blob/main/README.md",
    "loglevel": "info",
    "enabled": true,
    "licenseInformation": {
      "license": "MIT",
      "type": "free"
    }
  },
  "native": {
    "apiKey": "",
    "deviceName": "ioBroker",
    "streamPort": 8097,
    "streamHost": "",
    "apiPort": 9090,
    "format": "mp3",
    "targets": [],
    "stopAfterSec": 30
  },
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "role": "indicator.connected",
        "name": "Soloist running and logged in",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    }
  ],
  "encryptedNative": [
    "apiKey"
  ],
  "protectedNative": [
    "apiKey"
  ],
  "notifications": [
    {
      "scope": "spotify-connect",
      "name": {
        "en": "Spotify Connect",
        "de": "Spotify Connect",
        "ru": "Spotify Connect"
      },
      "description": {
        "en": "Notifications of the Spotify Connect adapter",
        "de": "Meldungen des Spotify-Connect-Adapters",
        "ru": "Сообщения адаптера Spotify Connect"
      },
      "categories": [
        {
          "category": "soloistUpdate",
          "severity": "alert",
          "limit": 1,
          "regex": [],
          "name": {
            "en": "Soloist update failed",
            "de": "Soloist-Update fehlgeschlagen",
            "ru": "Не удалось обновить Soloist"
          },
          "description": {
            "en": "Spotify Soloist could not be updated and will stop working when the build expires.",
            "de": "Spotify Soloist konnte nicht aktualisiert werden und funktioniert nach Ablauf des Builds nicht mehr.",
            "ru": "Spotify Soloist не удалось обновить, после истечения срока сборки он перестанет работать."
          }
        }
      ]
    }
  ]
}
