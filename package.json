{
  "name": "iobroker.spotify-connect",
  "version": "0.1.0",
  "description": "Spotify Connect receiver for ioBroker based on Spotify Soloist; streams to any player with a media.url state",
  "author": {
    "name": "Denis Haev",
    "email": "dogafox@gmail.com"
  },
  "homepage": "https://github.com/ioBroker/ioBroker.spotify-connect",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "spotify",
    "spotify connect",
    "soloist",
    "audio",
    "speaker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ioBroker/ioBroker.spotify-connect.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/testing": "^6.3.1",
    "@iobroker/eslint-config": "^2.3.4",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint -c eslint.config.mjs",
    "test:package": "mocha test/package.js --exit",
    "test:integration": "mocha test/unit.test.js --exit",
    "test": "npm run build && npm run test:package && npm run test:integration",
    "update-packages": "npx -y npm-check-updates -u",
    "npm": "npm i --ignore-scripts",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.spotify-connect/issues"
  },
  "readmeFilename": "README.md"
}
